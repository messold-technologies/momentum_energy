# Server
PORT=3000
NODE_ENV=development

# Momentum Energy API - Sandbox
MOMENTUM_BASE_URL=https://ch2-preprod.api.momentumenergy.com.au/external-channels-exp-preprod
MOMENTUM_AUTH_URL=https://ch2-preprod.api.momentumenergy.com.au/oauth/token
MOMENTUM_CLIENT_ID=your_client_id_here
MOMENTUM_CLIENT_SECRET=your_client_secret_here

# 1st Energy (Tally Acquire API)
FIRST_ENERGY_BASE_URL=https://firstenergy.uconx.com.au/v2
FIRST_ENERGY_API_KEY=

# CORS - comma separated allowed origins
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Public address of the customer-facing site. Consent links are built from this and
# sent to customers, so in any deployed environment it must be the real domain.
# If unset, the first non-localhost entry in ALLOWED_ORIGINS is used.
PUBLIC_APP_URL=https://your-frontend-domain.com

# Database (PostgreSQL - e.g. Neon, Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (portal users - NOT Momentum API)
JWT_SECRET=your-secret-key-change-in-production

QA_ALLOWED_IPS=1.2.3.4

# Agent portal: shared password agents type to enter. The default is the company name
# and therefore guessable - change it in any real environment.
AGENT_PORTAL_PASSWORD=utilityhub
AGENT_PORTAL_SESSION_EXPIRES_IN=12h
